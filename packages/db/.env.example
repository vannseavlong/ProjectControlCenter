# Google OAuth2 credentials used purely for the backend-to-Sheets connection (lsdb requirement).
# See https://console.cloud.google.com/ — enable the Sheets API and Drive API, then create
# OAuth 2.0 credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# The Google Sheet ID that backs the single `admin` actor (plan §5).
ADMIN_SHEET_ID=

# Runtime credential the app's SheetAdapter uses to talk to Sheets (separate from the CLI's own
# `.lsdb-tokens.json`, which only `lsdb` commands read). Get this by running `lsdb sync` once
# from this package to complete the OAuth consent flow, then copy `refresh_token` out of the
# `.lsdb-tokens.json` it writes. IMPORTANT: this must also be set in apps/web's env (as
# RENDER_API_KEY/etc. are) — Next.js only loads env files from apps/web/, not sibling packages,
# and the API routes that actually call packages/db run inside that process.
ADMIN_OAUTH_REFRESH_TOKEN=
