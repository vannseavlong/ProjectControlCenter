# Google OAuth2 credentials used purely for the backend-to-Sheets connection (lsdb requirement).
# See https://console.cloud.google.com/ — enable the Sheets API and Drive API, then create
# OAuth 2.0 credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# The Google Sheet ID that backs the single `admin` actor (plan §5).
ADMIN_SHEET_ID=
