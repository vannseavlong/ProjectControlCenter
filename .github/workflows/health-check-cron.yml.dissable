name: Backend health-check cron

# Resolves plan-doc §10's cron decision: Vercel Cron's Hobby-plan tier only supports daily
# triggers, which is too infrequent to keep a free-tier Render service (sleeps after ~15min
# idle) warm. A GitHub Actions schedule can run every few minutes for free, so it's the default
# trigger for apps/web's /api/cron/health-check route. Swap to Vercel Cron in vercel.json instead
# if this project ever moves to a Pro plan.
on:
  schedule:
    - cron: "*/10 * * * *"
  workflow_dispatch: {}

jobs:
  ping:
    runs-on: ubuntu-latest
    steps:
      - name: Hit /api/cron/health-check
        # --fail alone swallows the response body on a non-2xx, which is exactly what you need to
        # see to tell a CRON_SECRET mismatch (401) apart from a stale/wrong PORTAL_URL (404/DNS
        # failure/timeout) — write the body out first, then --fail so the step still goes red.
        run: |
          http_code=$(curl --show-error --silent --output response.txt --write-out "%{http_code}" \
            -H "Authorization: Bearer ${{ secrets.CRON_SECRET }}" \
            "${{ secrets.PORTAL_URL }}/api/cron/health-check")
          echo "HTTP $http_code"
          cat response.txt
          if [ "$http_code" -lt 200 ] || [ "$http_code" -ge 300 ]; then
            exit 1
          fi
