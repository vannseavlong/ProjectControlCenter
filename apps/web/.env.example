# Render/Vercel API access for backend health checks and frontend deploy status.
# Separate from packages/db's .env.example, which holds the Google OAuth / Sheets credentials.
RENDER_API_KEY=
VERCEL_API_TOKEN=

# Google Cloud Text-to-Speech (Neural2 voices) for the Voice Console's spoken replies — natural-
# sounding, free up to 1M characters/month (forever-free tier, not a trial). Console → APIs &
# Services → enable "Cloud Text-to-Speech API" → Credentials → API key. Unrelated to
# GOOGLE_CLIENT_ID/ADMIN_OAUTH_REFRESH_TOKEN below (those are OAuth creds for the Sheets backend;
# this is a plain API key for the TTS REST endpoint).
GOOGLE_TTS_API_KEY=

# packages/db's Sheets connection, MIRRORED here — Next.js only loads env files from apps/web/,
# not sibling packages, and the API routes that call packages/db (projectsTable(), etc.) run
# inside this process. Same values as packages/db/.env; see that file's comments for how to get
# them. ADMIN_OAUTH_REFRESH_TOKEN is the app's *runtime* credential (auto-refreshes the access
# token via googleapis) — separate from the CLI's own .lsdb-tokens.json, which `lsdb sync` etc.
# use and which never leaves packages/db.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
ADMIN_SHEET_ID=
ADMIN_OAUTH_REFRESH_TOKEN=

# Shared secret checked by GET /api/cron/health-check (see .github/workflows/health-check-cron.yml).
# Optional locally, but set it in every deployed environment so the endpoint isn't callable by anyone who finds the URL.
CRON_SECRET=

# Portal login (apps/web/src/middleware.ts) — separate from packages/db's Google OAuth, which is
# only for the backend-to-Sheets connection. This is a single-user tool: one allowed email, two
# ways to prove it's you (password or Google).
#
# Google Cloud Console → OAuth 2.0 Client ID → Web application. Redirect URI must exactly match
# GOOGLE_OAUTH_REDIRECT_URI below.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# The one identity allowed to sign in — checked against both the password form and the Google
# account email (must also be Google-verified).
AUTH_ALLOWED_EMAIL=

# scrypt hash in the form "<saltHex>:<hashHex>" (see hashPassword() in src/lib/auth/password.ts).
# Generate one with:
#   node -e "const c=require('crypto');const s=c.randomBytes(16);console.log(s.toString('hex')+':'+c.scryptSync(process.argv[1],s,64).toString('hex'))" 'your-password-here'
AUTH_PASSWORD_HASH=

# Random secret used to HMAC-sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=

# Voice Console
GOOGLE_TTS_API_KEY=