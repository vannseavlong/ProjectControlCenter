# Same Sheets/OAuth credentials as packages/db/.env — mirrored here for the same reason
# apps/web mirrors them: Node processes don't share env across sibling packages, and this
# process is the one that actually calls agentsTable()/commandQueueTable()/settingsTable() at
# runtime. See packages/db/.env.example for how to obtain each value.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
ADMIN_SHEET_ID=
ADMIN_OAUTH_REFRESH_TOKEN=

# Optional agent-bridge-specific tuning — sensible defaults in src/config.ts, only set these if
# you actually need to change them.
# AGENT_BRIDGE_POLL_INTERVAL_MS=10000
# AGENT_BRIDGE_COMMAND_TIMEOUT_MS=600000
# AGENT_BRIDGE_MAX_RESULT_LENGTH=40000
# AGENT_BRIDGE_CLAUDE_BIN=claude
